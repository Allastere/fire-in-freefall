{
  "pmma_slab_co2_final": {
    "version": 1,
    "phenomenon": "solid_combustion_chamber_co2",
    "target": "co2_final_pct",
    "unit": "%",
    "filters": {
      "material_name": "PMMA",
      "geometry": "Thick Slab",
      "flow_direction": "Opposed",
      "gravity_level": "0g"
    },
    "numeric_features": [
      "o2_initial_pct",
      "flow_velocity_initial_cm_s",
      "thickness_mm",
      "width_cm",
      "co2_initial_pct",
      "is_reused_sample"
    ],
    "categorical_features": [
      "burn_sides"
    ],
    "constant_conditions": {
      "pressure_psi": 14.7,
      "gravity_g": 0.0
    },
    "seed": 42,
    "interval_alpha": 0.1,
    "scientific_review": "research_only",
    "promotion": {
      "max_mae": null,
      "max_rmse": null,
      "max_interval_width": null,
      "min_test_coverage": 0.9,
      "min_local_groups": 3
    },
    "limitations": [
      "Research candidate only: measurement duration, complete airflow history and independent campaign validation are unavailable.",
      "14.7 psi is an importer assumption, not a measured pressure feature.",
      "Only the source-backed PMMA slab/opposed-flow series is used; no partial-gravity or high-oxygen predictions are supported.",
      "Material reuse and burn-side descriptions require scientific review before deployment.",
      "No production quality tolerances have been approved. Training does not imply promotion."
    ]
  },
